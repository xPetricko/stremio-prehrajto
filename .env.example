# Public base URL where Stremio can reach this addon (https required for non-local use)
PUBLIC_URL=http://127.0.0.1:7000
PORT=7000
# Volitelné: TMDB klíč (zdarma) přidá další české/slovenské názvy; základ jede i bez něj přes Wikidata
TMDB_API_KEY=
# true (default) = stream bytes through the addon; false = 302 redirect to the CDN (token may be IP-bound)
PROXY_STREAMS=true
# 1 = enable /debug/* routes
DEBUG=

# Autentizace: tajný token v URL (min. 24 znaků), generuj např. `openssl rand -hex 24`. Povinné, pokud PUBLIC_URL není localhost.
# Manifest pak běží na PUBLIC_URL/<ADDON_TOKEN>/manifest.json
ADDON_TOKEN=7736b5ceb5303c3c41fa4c87c21d235083aee554f29653d6
# Za reverzní proxy na NASu nastav 1 (aby se správně počítaly IP při limitu neúspěšných pokusů)
TRUST_PROXY=1

# Minimální odstup mezi požadavky na prehrajto (ms); při 429 zvyš
REQUEST_GAP_MS=1500
